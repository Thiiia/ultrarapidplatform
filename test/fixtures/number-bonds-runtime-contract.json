{
  "version": 1,
  "activityKey": "number-bonds",
  "timingPolicy": {
    "version": 1,
    "minimumHitSpacingSeconds": 7.5,
    "finalInteractionTailSeconds": 12,
    "allowSimultaneousHits": false
  },
  "targetPolicy": "whole-token",
  "hitCountPolicy": "exactly-one-per-generated-gem",
  "hitPadLayouts": [
    { "layoutVersion": 1, "pad": "topLeft", "expectedSlot": 0 },
    { "layoutVersion": 1, "pad": "topRight", "expectedSlot": 1 },
    { "layoutVersion": 1, "pad": "left", "expectedSlot": 2 },
    { "layoutVersion": 1, "pad": "right", "expectedSlot": 3 },
    { "layoutVersion": 1, "pad": "bottomLeft", "expectedSlot": 4 },
    { "layoutVersion": 1, "pad": "bottomRight", "expectedSlot": 5 },
    { "layoutVersion": 2, "pad": "top", "expectedSlot": 0, "label": "Top", "xUnit": 0, "yUnit": 1 },
    { "layoutVersion": 2, "pad": "upperRight", "expectedSlot": 1, "label": "Upper right", "xUnit": 0.7769516728624535, "yUnit": 0.6133828996282528 },
    { "layoutVersion": 2, "pad": "lowerRight", "expectedSlot": 2, "label": "Lower right", "xUnit": 0.7769516728624535, "yUnit": -0.620817843866171 },
    { "layoutVersion": 2, "pad": "bottom", "expectedSlot": 3, "label": "Bottom", "xUnit": 0, "yUnit": -1 },
    { "layoutVersion": 2, "pad": "lowerLeft", "expectedSlot": 4, "label": "Lower left", "xUnit": -0.7769516728624535, "yUnit": -0.620817843866171 },
    { "layoutVersion": 2, "pad": "upperLeft", "expectedSlot": 5, "label": "Upper left", "xUnit": -0.7769516728624535, "yUnit": 0.6133828996282528 }
  ],
  "cases": [
    {
      "id": "at-policy-boundary",
      "encounters": [
        { "id": "hit-1", "type": "hit", "startSeconds": 8 },
        { "id": "hit-2", "type": "hit", "startSeconds": 15.5 }
      ],
      "stopAtSeconds": 27.5,
      "hasStopAtSeconds": true,
      "expectedIssues": []
    },
    {
      "id": "one-hundredth-short-spacing",
      "encounters": [
        { "id": "hit-1", "type": "hit", "startSeconds": 8 },
        { "id": "hit-2", "type": "hit", "startSeconds": 15.49 }
      ],
      "stopAtSeconds": 27.49,
      "hasStopAtSeconds": true,
      "expectedIssues": [
        {
          "code": "gem_spacing",
          "encounterId": "hit-2",
          "relatedEncounterId": "hit-1",
          "relatedStartSeconds": 8,
          "encounterStartSeconds": 15.49,
          "earliestStartSeconds": 15.5,
          "conflictStartSeconds": 8,
          "conflictEndSeconds": 15.49,
          "earliestSafeStartSeconds": 15.5
        }
      ]
    },
    {
      "id": "simultaneous-disjoint-hits",
      "encounters": [
        { "id": "hit-1", "type": "hit", "startSeconds": 8 },
        { "id": "hit-2", "type": "hit", "startSeconds": 8 }
      ],
      "stopAtSeconds": 20,
      "hasStopAtSeconds": true,
      "expectedIssues": [
        {
          "code": "simultaneous_hits",
          "encounterId": "hit-2",
          "relatedEncounterId": "hit-1",
          "relatedStartSeconds": 8,
          "encounterStartSeconds": 8,
          "conflictStartSeconds": 8,
          "conflictEndSeconds": 8,
          "earliestSafeStartSeconds": 15.5
        }
      ]
    },
    {
      "id": "one-tick-short-final-tail",
      "encounters": [
        { "id": "hit-1", "type": "hit", "startSeconds": 8 }
      ],
      "stopAtSeconds": 19.99,
      "hasStopAtSeconds": true,
      "expectedIssues": [
        {
          "code": "gem_tail",
          "encounterId": "hit-1",
          "minimumStopSeconds": 20
        }
      ]
    },
    {
      "id": "missing-stop-boundary",
      "encounters": [
        { "id": "hit-1", "type": "hit", "startSeconds": 8 }
      ],
      "hasStopAtSeconds": false,
      "expectedIssues": [
        {
          "code": "stop_required",
          "encounterId": "hit-1",
          "minimumStopSeconds": 20
        }
      ]
    },
    {
      "id": "final-cue-after-stop",
      "encounters": [
        { "id": "hit-1", "type": "hit", "startSeconds": 21 }
      ],
      "stopAtSeconds": 20,
      "hasStopAtSeconds": true,
      "expectedIssues": [
        {
          "code": "gem_tail",
          "encounterId": "hit-1",
          "minimumStopSeconds": 33
        }
      ]
    },
    {
      "id": "algebra-same-event-disjoint-hits",
      "activityKey": "early-algebra",
      "encounters": [
        { "id": "hit-1", "type": "hit", "startSeconds": 8 },
        { "id": "hit-2", "type": "hit", "startSeconds": 8 }
      ],
      "hasStopAtSeconds": false,
      "expectedIssues": []
    }
  ]
}
