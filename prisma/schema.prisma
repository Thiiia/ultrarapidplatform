generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  auth0Sub  String   @unique
  email     String   @unique
  name      String?
  role      Role     @default(student)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  student
  teacher
  admin
}