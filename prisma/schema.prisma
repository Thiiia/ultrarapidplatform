generator client {
  provider      = "prisma-client-js"
  // Keep the generated client usable from both the Windows editor shell and
  // the WSL/Debian test environment used by this repository.
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id      String  @id @default(cuid())
  name    String
  city    String?
  country String? @default("England")

  users   User[]
  classes Class[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model User {
  id       String     @id @default(cuid())
  auth0Sub String     @unique
  email    String     @unique
  name     String?
  role     Role       @default(student)
  status   UserStatus @default(active)

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  authoredMissions      Mission[]                 @relation("MissionAuthor")
  authoredCharts        SongChart[]               @relation("ChartAuthor")
  gameContentRevisions  GameContentRevision[]     @relation("RevisionAuthor")
  progressRecords       Progress[]
  playerWorkspaces      PlayerLessonWorkspace[]
  deviceCalibrations    PlayerDeviceCalibration[]
  playerWriteRateLimits PlayerWriteRateLimit[]
  playerLaunchAttempts  PlayerLaunchAttempt[]
  playerRunOutcomes      PlayerRunOutcome[]

  /**
   * Existing one-to-many teacher/class relationship.
   * This can be treated as the primary teacher relationship.
   */
  classesTaught Class[] @relation("ClassTeacher")

  /**
   * New many-to-many teacher/class assignments.
   * Use this when a teacher needs to be assigned to multiple classes,
   * and when a class may eventually support multiple teachers.
   */
  teacherClassAssignments TeacherClass[]

  /**
   * Existing student/class assignments.
   * This allows students to be assigned to multiple classes.
   */
  classMemberships ClassStudent[]

  studentAssignments Assignment[] @relation("AssignmentStudent")
  createdAssignments Assignment[] @relation("AssignmentCreator")

  @@index([schoolId])
  @@index([role])
  @@index([status])
}

model Class {
  id          String  @id @default(cuid())
  name        String
  description String?
  term        String?
  isArchived  Boolean @default(false)

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  /**
   * Existing primary teacher field.
   * Keep this for compatibility with your current dashboard/data code.
   */
  teacherId String
  teacher   User   @relation("ClassTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  /**
   * New assigned-teachers relationship.
   */
  teacherAssignments TeacherClass[]

  /**
   * Existing assigned-students relationship.
   */
  students ClassStudent[]

  assignments Assignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([teacherId])
  @@index([isArchived])
}

model TeacherClass {
  teacherId String
  classId   String

  teacher User  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([teacherId, classId])
  @@index([teacherId])
  @@index([classId])
}

model ClassStudent {
  classId   String
  studentId String

  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([classId, studentId])
  @@index([studentId])
}

model Mission {
  id          String   @id @default(cuid())
  title       String
  description String?
  published   Boolean  @default(false)
  contentJson Json
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author      User         @relation("MissionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  progress    Progress[]
  assignments Assignment[]

  @@index([authorId])
  @@index([published])
}

model Assignment {
  id          String  @id @default(cuid())
  title       String
  description String?

  missionId String
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  classId String?
  class   Class?  @relation(fields: [classId], references: [id], onDelete: Cascade)

  studentId String?
  student   User?   @relation("AssignmentStudent", fields: [studentId], references: [id], onDelete: Cascade)

  createdByUserId String
  createdBy       User   @relation("AssignmentCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  status AssignmentStatus @default(assigned)

  dueAt          DateTime?
  availableFrom  DateTime?
  availableUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([missionId])
  @@index([classId])
  @@index([studentId])
  @@index([createdByUserId])
  @@index([status])
}

model Progress {
  id        String         @id @default(cuid())
  userId    String
  missionId String
  status    ProgressStatus @default(not_started)
  score     Float          @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId], name: "userId_missionId")
  @@index([userId])
  @@index([missionId])
  @@index([status])
}

model SongAsset {
  id              String  @id @default(cuid())
  title           String
  artist          String?
  durationSeconds Int?

  songBucket String @default("Songs")
  songPath   String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  charts               SongChart[]
  gameContentRevisions GameContentRevision[]

  @@index([isActive])
  @@index([title])
}

model SongChart {
  id String @id @default(cuid())

  songAssetId String
  songAsset   SongAsset @relation(fields: [songAssetId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("ChartAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  // One of: "number-bonds" | "equations" | "missing-numbers" | "early-algebra"
  activityKey String

  chartBucket String @default("Charts")
  chartPath   String

  sidecarBucket String? @default("SidecarJsons")
  sidecarPath   String?

  gameContentRevisions GameContentRevision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([songAssetId, authorId, activityKey])
  @@index([songAssetId])
  @@index([authorId])
  @@index([activityKey])
}

model GameContentRevision {
  revision              String                    @id @db.Uuid
  songChartId           String                    @map("song_chart_id")
  songChart             SongChart                 @relation(fields: [songChartId], references: [id], onDelete: Restrict)
  songAssetId           String                    @map("song_asset_id")
  songAsset             SongAsset                 @relation(fields: [songAssetId], references: [id], onDelete: Restrict)
  activityKey           String                    @map("activity_key")
  authorId              String                    @map("author_id")
  author                User                      @relation("RevisionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  chartBucket           String                    @map("chart_bucket")
  chartPath             String                    @map("chart_path")
  sidecarBucket         String                    @map("sidecar_bucket")
  sidecarPath           String                    @map("sidecar_path")
  audioBucket           String                    @map("audio_bucket")
  audioPath             String                    @map("audio_path")
  chartSha256           String?                   @map("chart_sha256")
  sidecarSha256         String?                   @map("sidecar_sha256")
  audioSha256           String?                   @map("audio_sha256")
  authoredLessonVersion Int?                      @map("authored_lesson_version")
  authoredMode          String?                   @map("authored_mode")
  equationCount         Int?                      @map("equation_count")
  encounterCount        Int?                      @map("encounter_count")
  targetCount           Int?                      @map("target_count")
  publicationRequestId  String?                   @unique @map("publication_request_id")
  status                GameContentRevisionStatus @default(draft)
  failureCode           String?                   @map("failure_code")
  failureMessage        String?                   @map("failure_message")
  createdAt             DateTime                  @default(now()) @map("created_at")
  publishedAt           DateTime?                 @map("published_at")

  @@index([songAssetId, activityKey, authorId, status, publishedAt])
  @@map("game_content_revisions")
}

model PlayerLessonWorkspace {
  id          String   @id @default(cuid())
  userId      String
  songAssetId String
  activityKey String
  authorId    String
  revision    String
  payload     Json
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, songAssetId, activityKey, authorId, revision])
  @@index([userId])
  @@map("player_lesson_workspaces")
}

model PlayerDeviceCalibration {
  id              String   @id @default(cuid())
  userId          String
  installationId  String   @db.Uuid
  offsetMs        Int
  protocolVersion Int
  calibratedAt    DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, installationId])
  @@index([userId])
  @@map("player_device_calibrations")
}

model PlayerWriteRateLimit {
  id          String   @id @default(cuid())
  userId      String
  action      String
  windowStart DateTime
  count       Int      @default(0)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, action])
  @@index([windowStart])
  @@map("player_write_rate_limits")
}

model PlayerLaunchAttempt {
  id              String           @id @default(cuid())
  launchAttemptId String           @unique @db.Uuid
  userId          String
  songAssetId     String
  activityKey     String
  authorId        String
  revision        String?
  source          String
  templateId      String?
  receipt         Json
  createdAt       DateTime         @default(now())

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  outcome   PlayerRunOutcome?

  @@index([userId, createdAt])
  @@index([songAssetId, activityKey, revision])
  @@unique([launchAttemptId, userId])
  @@map("player_launch_attempts")
}

model PlayerRunOutcome {
  id              String   @id @default(cuid())
  launchAttemptId String   @unique @db.Uuid
  userId          String
  outcome         String
  completedEvents Int      @default(0)
  hitAttempts     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  launchAttempt PlayerLaunchAttempt @relation(fields: [launchAttemptId, userId], references: [launchAttemptId, userId], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, outcome])
  @@unique([launchAttemptId, userId])
  @@map("player_run_outcomes")
}

enum Role {
  student
  teacher
  admin
}

enum UserStatus {
  active
  inactive
  invited
  suspended
}

enum AssignmentStatus {
  assigned
  in_progress
  completed
  overdue
}

enum ProgressStatus {
  not_started
  in_progress
  complete
}

enum GameContentRevisionStatus {
  draft
  publishing
  ready
  failed

  @@map("game_content_revision_status")
}
